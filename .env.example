# ChainBeat configuration — every value is OPTIONAL and NON-SECRET.
# This app needs no API key, no private key and no seed phrase. Never put secrets in VITE_* variables:
# anything prefixed with VITE_ is embedded in the public JavaScript bundle.

# Host the app under a sub-path (e.g. GitHub Pages). Default: "/"
# VITE_BASE_PATH=/chainbeat/

# Default selected network id (cosmoshub | osmosis). Default: cosmoshub
# VITE_DEFAULT_CHAIN=cosmoshub

# Simulated network latency in milliseconds for Demo Mode (0 disables it; used by tests). Default: 280
# VITE_SIM_LATENCY_MS=280

# Footer links. Shown only when set (https:// or http://localhost only; anything else is ignored). No other
# social or external links exist anywhere in the app.
# VITE_DOCS_URL=https://example.org/chainbeat/docs
# VITE_GITHUB_URL=https://github.com/your-name/chainbeat

# Cosmos REST (LCD) endpoint. Setting it only adds a "Test connection" button to Settings: two read-only GET
# requests to this address, results shown, nothing stored. The app still shows simulated data everywhere —
# a live data source is NOT implemented (see docs/LIMITATIONS.md).
# VITE_COSMOS_REST_URL=https://rest.example.org

# Google OAuth client ID for the real "Sign in with Google" button on /login and /register. This is a PUBLIC
# identifier (it ends with .apps.googleusercontent.com) — never put a client secret (GOCSPX-…) here. Create one in
# the Google Cloud console (APIs & Services > Credentials > OAuth client ID > Web application) and add this site's
# origin, e.g. http://localhost:4173, under "Authorized JavaScript origins". Without it the button is a clearly
# labelled simulation and the page never contacts Google. A visitor can also paste a client ID on /login (it is then
# kept in that browser only). See docs/AUTH.md.
# VITE_GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com
